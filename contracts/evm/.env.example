# Copy to .env and fill in. Never commit .env.

# Deployer key (0x-prefixed). Use a throwaway key for testnet.
PRIVATE_KEY=

# Monad testnet RPC — see https://docs.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Block explorer verification (values from Monad docs)
MONAD_ETHERSCAN_API_KEY=
MONAD_ETHERSCAN_URL=
