# Copy to .env and fill in. Never commit .env.

# Deployer key (0x-prefixed). Use a throwaway key for testnet.
PRIVATE_KEY=

# Monad testnet — chain id 10143, currency MON
# foundry.toml's `monad_testnet` endpoint uses rpc.ankr.com/monad_testnet.
# Alternates: https://rpc-testnet.monadinfra.com | https://testnet-rpc.monad.xyz (was unreachable from some networks)
MONAD_TESTNET_RPC_URL=https://rpc.ankr.com/monad_testnet

# Faucet:   https://faucet.monad.xyz
# Explorer: https://testnet.monadscan.com  (also https://testnet.monadvision.com)

# Contract verification on MonadScan (Etherscan-compatible). Get a key from testnet.monadscan.com.
MONADSCAN_API_KEY=
