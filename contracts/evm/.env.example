# Copy to .env and fill in. Never commit .env.

# Deployer key (0x-prefixed). Use a throwaway key for testnet.
PRIVATE_KEY=

# Monad testnet — chain id 10143, currency MON
# Public RPCs (pick one): https://testnet-rpc.monad.xyz | https://rpc.ankr.com/monad_testnet | https://rpc-testnet.monadinfra.com
# foundry.toml already defaults to testnet-rpc.monad.xyz; override here if you hit rate limits.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz

# Faucet:   https://faucet.monad.xyz
# Explorer: https://testnet.monadscan.com  (also https://testnet.monadvision.com)

# Contract verification on MonadScan (Etherscan-compatible). Get a key from testnet.monadscan.com.
MONADSCAN_API_KEY=
