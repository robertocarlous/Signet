{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Signet",
  "description": "Decentralized attestation infrastructure on Stellar. Build verifiable credential systems with cryptographic delegation and payment-gated resolvers.",
  "theme": "aspen",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg"
  },
  "favicon": "/images/favicon.ico",
  "colors": {
    "primary": "#ff8700",
    "light": "#ff8700",
    "dark": "#ff8700"
  },
  "fonts": {
    "family": "Mona Sans"
  },

  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "introduction",
              "concepts/how-it-works",
              "quickstart"
            ]
          },
          {
            "group": "Concepts",
            "pages": [
              "concepts/schemas",
              "concepts/attestations",
              "concepts/resolvers",
              "concepts/authorities",
              "concepts/delegates"
            ]
          },
          {
            "group": "Stellar",
            "pages": [
              "stellar/getting-started",
              "stellar/schemas",
              "stellar/reference",
              "chains/stellar/overview"
            ]
          },
          {
            "group": "Examples",
            "pages": [
              "examples/react-integration",
              "examples/kyc-verification",
              "examples/event-attendance",
              "examples/dao-membership",
              "examples/identity"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Explorer",
          "href": "https://signet-mainnet.vercel.app",
          "icon": "magnifying-glass"
        },
        {
          "anchor": "Sandbox",
          "href": "https://signet-sandbox.vercel.app",
          "icon": "play"
        },
        {
          "anchor": "GitHub",
          "href": "https://github.com/robertocarlous/Signet",
          "icon": "github"
        },
        {
          "anchor": "Discord",
          "href": "https://discord.com/invite/7kVur5ja5m",
          "icon": "discord"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "GitHub",
        "href": "https://github.com/robertocarlous/Signet"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://signet.vercel.app"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/robertocarlous/Signet",
      "x": "https://twitter.com/signetprotocol",
      "discord": "https://discord.com/invite/7kVur5ja5m"
    },
    "links": [
      {
        "header": "Resources",
        "items": [
          {
            "label": "Website",
            "href": "https://signet.vercel.app"
          },
          {
            "label": "Explorer",
            "href": "https://signet-mainnet.vercel.app"
          },
          {
            "label": "Testnet",
            "href": "https://signet-testnet.vercel.app"
          }
        ]
      },
      {
        "header": "Company",
        "items": [
          {
            "label": "About",
            "href": "https://signet.vercel.app/about"
          },
          {
            "label": "Privacy Policy",
            "href": "https://signet.vercel.app/privacy"
          }
        ]
      }
    ]
  },

  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude"]
  },
  "errors": {
    "404": {
      "redirect": true
    }
  },
  "seo": {
    "metatags": {
      "og:title": "SignetProtocol Documentation",
      "og:description": "The trust layer for Web3. Build verifiable reputation systems with one line of code.",
      "og:image": "/images/og.png"
    }
  }
}
