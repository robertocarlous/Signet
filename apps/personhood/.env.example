# Relayer key that pays gas for personhood enrolments (server-only, never exposed to the client).
# Use a throwaway wallet funded from https://faucet.monad.xyz — keep a few MON in it.
RELAYER_PRIVATE_KEY=0x

# Optional overrides (defaults target Monad testnet chain 10143).
MONAD_RPC_URL=https://rpc.ankr.com/monad_testnet

# The WebAuthn Relying Party ID — the site's registrable domain.
# localhost for dev; your deployed host (no scheme, no port) in production, e.g. signet-personhood.vercel.app
NEXT_PUBLIC_RP_ID=localhost
